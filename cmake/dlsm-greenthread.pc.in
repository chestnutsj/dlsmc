prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: dlsm-greenthread
Description: Cooperative M:N green-thread runtime
Version: @PROJECT_VERSION@
Libs: -L${libdir} -ldlsm_greenthread -ldlsm_sync -ldlsm_core
Libs.private: -pthread
Cflags: -I${includedir}
