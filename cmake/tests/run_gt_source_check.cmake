if(NOT DEFINED DLSM_SOURCE_DIR OR NOT DEFINED DLSM_CHECK_ROOT)
  message(FATAL_ERROR "DLSM_SOURCE_DIR and DLSM_CHECK_ROOT are required")
endif()

set(PROJECT_SOURCE_DIR "${DLSM_CHECK_ROOT}")
set(CMAKE_BINARY_DIR "${CMAKE_CURRENT_BINARY_DIR}")
if(NOT DEFINED DLSM_CHECK_ENABLED)
  set(DLSM_CHECK_ENABLED ON)
endif()
set(DLSM_GT_NATIVE_TLS_CHECK "${DLSM_CHECK_ENABLED}" CACHE BOOL "" FORCE)
if(NOT DEFINED DLSM_BLOCKING_WARNING_ENABLED)
  set(DLSM_BLOCKING_WARNING_ENABLED OFF)
endif()
set(DLSM_GT_BLOCKING_CALL_WARNING "${DLSM_BLOCKING_WARNING_ENABLED}"
  CACHE BOOL "" FORCE)
include("${DLSM_SOURCE_DIR}/cmake/gt_source_checks.cmake")
dlsm_gt_enable_source_checks(ROOTS "${DLSM_CHECK_ROOT}")
