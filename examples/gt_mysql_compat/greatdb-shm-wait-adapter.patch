+uint64_t deadline_ns(const struct timespec *deadline) {
+  if (deadline == nullptr) return UINT64_MAX;
+  const uint64_t seconds = static_cast<uint64_t>(deadline->tv_sec);
+  if (seconds > (UINT64_MAX - static_cast<uint64_t>(deadline->tv_nsec)) /
+                    UINT64_C(1000000000))
+    return UINT64_MAX - 1;
+  return seconds * UINT64_C(1000000000) +
+         static_cast<uint64_t>(deadline->tv_nsec);
+}
