diff --git a/include/violite.h b/include/violite.h
index 4a25309..8b86d8f 100644
--- a/include/violite.h
+++ b/include/violite.h
@@ -181,6 +181,45 @@ enum enum_vio_linux_shm_wait_mode {
   VIO_LINUX_SHM_WAIT_FUTEX = 1
 };
 
+/**
+  Result returned by a process-local Linux SHM cooperative wait adapter.
+
+  A wakeup may be spurious. The VIO implementation always rechecks the ring,
+  connection state, epoch, and deadline after the adapter returns.
+*/
+enum enum_vio_linux_shm_adapter_wait_result {
+  VIO_LINUX_SHM_ADAPTER_WOKEN = 0,
+  VIO_LINUX_SHM_ADAPTER_TIMED_OUT = 1,
+  VIO_LINUX_SHM_ADAPTER_ERROR = 2
+};
+
+/**
+  Optional process-local adapter for cooperative Linux SHM waits.
+
+  `applies` must return true only when the calling execution context can use
+  `wait` (for example, while running on a green thread). `wait` suspends that
+  execution context while `*epoch == expected`. `deadline_ns` is an absolute
+  CLOCK_MONOTONIC deadline, or UINT64_MAX when no timeout was requested.
+
+  The object and context referenced by it must remain valid until the adapter
+  is cleared and all concurrent Linux SHM operations have completed. Install
+  or clear an adapter only while client connection activity is quiescent.
+*/
+struct Vio_linux_shm_wait_adapter {
+  bool (*applies)(void *context);
+  enum enum_vio_linux_shm_adapter_wait_result (*wait)(
+      void *context, const uint32_t *epoch, uint32_t expected,
+      uint64_t deadline_ns);
+  void *context;
+};
+
+/**
+  Install a process-local Linux SHM wait adapter, or pass nullptr to clear it.
+  Processes that do not install an adapter retain the original behavior.
+*/
+void vio_linux_shm_set_wait_adapter(
+    const Vio_linux_shm_wait_adapter *adapter);
+
 /** Return the bytes required for one connection mapping, or zero on error. */
 size_t vio_linux_shm_mapping_size(uint32_t client_to_server_capacity,
                                   uint32_t server_to_client_capacity);
